# Stash comes with a built-in intelligent engine trained on student finance (llm/data/stash_train.jsonl).
# It works 100% offline out of the box with zero setup, zero rate limits, and no API keys required!
#
# If you wish to optionally connect external cloud or local LLMs, you can configure them below:

# 1. FREE HIGH-SPEED CLOUD (Recommended): Groq (https://console.groq.com)
# Blazing-fast inference (500+ tok/s), generous free tier, runs Llama 3.3 70B & Llama 3.1 8B.
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# AI_PROVIDER=groq

# 2. FREE COMMUNITY CLOUD: OpenRouter (https://openrouter.ai)
# Free models like Llama 3.2 3B, Gemma 2 9B, Mistral 7B.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
# AI_PROVIDER=openrouter

# 3. 100% FREE WITH NO LIMITS (SELF-HOSTED / LOCAL): Ollama (https://ollama.ai) or llm/serve.py
# Run completely private and offline on your computer with unlimited requests.
# LOCAL_LLM_URL=http://localhost:11434
# LOCAL_LLM_MODEL=llama3.2
# AI_PROVIDER=local

# 4. HUGGING FACE (Serverless Inference or dedicated endpoint):
# HF_TOKEN=
# HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# AI_PROVIDER=huggingface

# 5. PAID (optional): Anthropic Claude (https://console.anthropic.com)
# ANTHROPIC_API_KEY=
# GURU_MODEL=claude-sonnet-5-5
# PARSER_MODEL=claude-haiku-4-5

# 6. BUILT-IN OFFLINE ENGINE (Zero setup, grounded in stash_train.jsonl):
AI_PROVIDER=builtin

# Optional: Require this passcode for AI calls.
# APP_PASSCODE=

# Link to your feedback form (e.g. a Google Form).
# NEXT_PUBLIC_FEEDBACK_URL=https://forms.gle/...

# 7. FIREBASE CLOUD SYNC & AUTHENTICATION
# Obtain these from your Firebase Console > Project Settings > General > Your apps (Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
