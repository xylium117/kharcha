# FREE: Hugging Face Serverless Inference API (get a free token at https://huggingface.co/settings/tokens).
# Runs top open-source models (like Qwen2.5-7B or Llama-3.2-3B) directly on Hugging Face cloud, no local GPU needed.
HF_TOKEN=
# HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# AI_PROVIDER=huggingface

# FREE: Google Gemini (get a key at https://aistudio.google.com/apikey – no credit card).
# On Gemini's free tier Google may use prompts to improve its products, so Kharcha only sends
# amounts, categories and goal numbers (no item names, places or friends' names).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest  (alias that always points to Google's current Flash model)

# PAID (optional): Anthropic Claude (https://console.anthropic.com). Used when no Gemini key is set,
# or when AI_PROVIDER=claude.
ANTHROPIC_API_KEY=
# GURU_MODEL=claude-sonnet-5-5
# PARSER_MODEL=claude-haiku-4-5

# SELF-HOSTED (optional): Local model via llm/serve.py or Ollama (http://localhost:11434).
# LOCAL_LLM_URL=http://localhost:11434

# Require this passcode for AI calls. SET IT when the app is online, so strangers can't use your quota.
# Enter the same passcode in the app under Settings → AI guide.
# APP_PASSCODE=

# Link to your feedback form (e.g. a Google Form). Shows a Feedback button and a weekly check-in.
# NEXT_PUBLIC_FEEDBACK_URL=https://forms.gle/...
